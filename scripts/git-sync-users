#!/usr/bin/env python3
"""
scripts/git-sync-users - Declarative user, group, and permission reconciliation for ro-git.

Reconciles <root>/users/<user> into <etc>/passwd and <etc>/group,
syncs <root>/teams/<team>/members into <etc>/group, and enforces
StrictModes and setgid filesystem invariants across <root>/users and <root>/teams.
"""

from __future__ import annotations

import argparse
import os
import re
import tempfile
from pathlib import Path
from typing import Dict, List, Optional, Set, Tuple

VALID_NAME_RE = re.compile(r"^[a-zA-Z0-9_-]+$")
GIT_AUTO_SHELL = "/usr/local/bin/git-auto-shell"
NOBODY_ID = 65534
MIN_USER_ID = 1000
MIN_TEAM_GID = 2000

DEFAULT_PASSWD_ROWS = [
    ["root", "x", "0", "0", "root", "/root", "/bin/sh"],
    ["nobody", "x", str(NOBODY_ID), str(NOBODY_ID), "nobody", "/", "/usr/sbin/nologin"],
]
DEFAULT_GROUP_ROWS = [
    ["root", "x", "0", ""],
    ["nobody", "x", str(NOBODY_ID), ""],
]


def _is_valid_name(name: str) -> bool:
    return bool(VALID_NAME_RE.match(name))


def _reject_symlink(path: Path) -> None:
    if path.is_symlink():
        raise ValueError(f"Refusing to operate on symlink: {path}")


def _safe_chown_chmod(path: Path, uid: int, gid: int, mode: int) -> None:
    """Apply chown (ignoring EPERM when unprivileged) followed by chmod without following symlinks."""
    _reject_symlink(path)
    try:
        os.chown(path, uid, gid, follow_symlinks=False)
    except PermissionError:
        pass
    os.chmod(path, mode)


def _ensure_real_dir(path: Path, uid: int, gid: int, mode: int) -> None:
    """Ensure path is a real directory (not a symlink) and enforce ownership and mode."""
    _reject_symlink(path)
    path.mkdir(parents=True, exist_ok=True)
    if not path.is_dir() or path.is_symlink():
        raise ValueError(f"Expected real directory at {path}")
    _safe_chown_chmod(path, uid, gid, mode)


def _write_atomic(path: Path, content: str, uid: int = 0, gid: int = 0, mode: int = 0o644) -> None:
    """Write content to a temporary file in path.parent, set permissions, and atomically replace path."""
    _reject_symlink(path)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=str(path.parent))
    tmp_path = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(content)
        _safe_chown_chmod(tmp_path, uid, gid, mode)
        os.replace(tmp_path, path)
    except Exception:
        tmp_path.unlink(missing_ok=True)
        raise


def _parse_colon_file(path: Path, field_count: int, defaults: List[List[str]]) -> List[List[str]]:
    _reject_symlink(path)
    if not path.exists():
        return [list(row) for row in defaults]
    rows: List[List[str]] = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line:
            continue
        parts = line.split(":")
        if len(parts) == field_count:
            rows.append(parts)
    return rows


def _is_managed_passwd_row(row: List[str]) -> bool:
    home, shell = row[5], row[6]
    return home.startswith("/users/") or shell == GIT_AUTO_SHELL


def _read_team_members(members_file: Path) -> List[str]:
    _reject_symlink(members_file)
    if not members_file.exists() or not members_file.is_file():
        return []
    seen: Set[str] = set()
    members: List[str] = []
    for raw in members_file.read_text(encoding="utf-8").splitlines():
        code = raw.split("#", 1)[0].strip()
        if not code:
            continue
        if _is_valid_name(code) and code not in seen:
            seen.add(code)
            members.append(code)
    return members


def _next_free_id(start: int, *used_sets: Set[int]) -> int:
    candidate = start
    while candidate == NOBODY_ID or any(candidate in s for s in used_sets):
        candidate += 1
    for s in used_sets:
        s.add(candidate)
    return candidate


def _enforce_user_permissions(users_dir: Path, user_ids: Dict[str, Tuple[int, int]]) -> None:
    for user, (uid, gid) in user_ids.items():
        udir = users_dir / user
        auth_keys = udir / "authorized_keys"
        for p in (udir, udir / "public", udir / "private", auth_keys):
            _reject_symlink(p)

        _ensure_real_dir(udir, uid, gid, 0o755)
        _ensure_real_dir(udir / "public", uid, gid, 0o755)
        _ensure_real_dir(udir / "private", uid, gid, 0o700)

        if auth_keys.exists():
            if not auth_keys.is_file():
                raise ValueError(f"Expected regular file at {auth_keys}")
            _safe_chown_chmod(auth_keys, uid, gid, 0o600)


def _enforce_team_permissions(teams_dir: Path, team_gids: Dict[str, int]) -> None:
    for team, tgid in team_gids.items():
        tdir = teams_dir / team
        members_file = tdir / "members"
        for p in (tdir, tdir / "public", tdir / "private", members_file):
            _reject_symlink(p)

        _ensure_real_dir(tdir, 0, tgid, 0o755)
        _ensure_real_dir(tdir / "public", 0, tgid, 0o2775)
        _ensure_real_dir(tdir / "private", 0, tgid, 0o2770)

        if members_file.exists():
            if not members_file.is_file():
                raise ValueError(f"Expected regular file at {members_file}")
            _safe_chown_chmod(members_file, 0, tgid, 0o640)


def sync_users_and_groups(
    root_dir: Optional[Path] = None,
    etc_dir: Optional[Path] = None,
) -> Dict[str, object]:
    raw_root = str(root_dir) if root_dir is not None else os.environ.get("RO_GIT_ROOT", "/")
    root = Path(raw_root).resolve() if raw_root != "/" else Path("/")

    if etc_dir is not None:
        etc = Path(etc_dir)
    elif os.environ.get("RO_GIT_ETC_DIR"):
        etc = Path(os.environ["RO_GIT_ETC_DIR"])
    else:
        etc = root / "etc"

    users_dir = root / "users"
    teams_dir = root / "teams"

    _ensure_real_dir(users_dir, 0, 0, 0o755)
    _ensure_real_dir(teams_dir, 0, 0, 0o755)
    etc.mkdir(parents=True, exist_ok=True)

    discovered_users = sorted(
        p.name for p in users_dir.iterdir() if p.is_dir() and not p.is_symlink() and _is_valid_name(p.name)
    )
    discovered_teams = sorted(
        p.name for p in teams_dir.iterdir() if p.is_dir() and not p.is_symlink() and _is_valid_name(p.name)
    )

    passwd_path = etc / "passwd"
    group_path = etc / "group"

    existing_passwd = _parse_colon_file(passwd_path, 7, DEFAULT_PASSWD_ROWS)
    existing_group = _parse_colon_file(group_path, 4, DEFAULT_GROUP_ROWS)

    system_passwd: List[List[str]] = []
    managed_passwd_by_name: Dict[str, List[str]] = {}
    system_user_names: Set[str] = set()
    system_primary_gids: Set[int] = set()
    used_uids: Set[int] = {0, NOBODY_ID}
    used_gids: Set[int] = {0, NOBODY_ID}

    for row in existing_passwd:
        name = row[0]
        try:
            uid, gid = int(row[2]), int(row[3])
        except ValueError:
            continue
        if _is_managed_passwd_row(row):
            managed_passwd_by_name[name] = row
            if name in discovered_users:
                used_uids.add(uid)
                used_gids.add(gid)
        else:
            system_passwd.append(row)
            system_user_names.add(name)
            system_primary_gids.add(gid)
            used_uids.add(uid)
            used_gids.add(gid)

    existing_group_by_name: Dict[str, List[str]] = {}
    system_groups: List[List[str]] = []
    for row in existing_group:
        gname = row[0]
        try:
            gid = int(row[2])
        except ValueError:
            continue
        existing_group_by_name[gname] = row
        is_system_group = (
            gid < MIN_USER_ID
            or gid == NOBODY_ID
            or gname in system_user_names
            or gid in system_primary_gids
        )
        if is_system_group and gname not in discovered_users and gname not in discovered_teams:
            system_groups.append(row)
            used_gids.add(gid)
        elif gname in discovered_users or gname in discovered_teams:
            used_gids.add(gid)

    user_ids: Dict[str, Tuple[int, int]] = {}
    new_user_passwd_rows: List[List[str]] = []
    new_user_group_rows: List[List[str]] = []

    for user in discovered_users:
        if user in managed_passwd_by_name:
            uid = int(managed_passwd_by_name[user][2])
            gid = int(managed_passwd_by_name[user][3])
        elif user in existing_group_by_name:
            gid = int(existing_group_by_name[user][2])
            if gid not in used_uids:
                uid = gid
                used_uids.add(uid)
            else:
                uid = _next_free_id(MIN_USER_ID, used_uids)
        else:
            uid = _next_free_id(MIN_USER_ID, used_uids, used_gids)
            gid = uid

        user_ids[user] = (uid, gid)
        new_user_passwd_rows.append([user, "x", str(uid), str(gid), user, f"/users/{user}", GIT_AUTO_SHELL])
        if user not in discovered_teams:
            new_user_group_rows.append([user, "x", str(gid), ""])

    team_gids: Dict[str, int] = {}
    team_members_map: Dict[str, List[str]] = {}
    new_team_group_rows: List[List[str]] = []

    for team in discovered_teams:
        members = _read_team_members(teams_dir / team / "members")
        team_members_map[team] = members

        if team in user_ids:
            gid = user_ids[team][1]
        elif team in existing_group_by_name:
            gid = int(existing_group_by_name[team][2])
            used_gids.add(gid)
        else:
            gid = _next_free_id(MIN_TEAM_GID, used_gids)

        team_gids[team] = gid
        new_team_group_rows.append([team, "x", str(gid), ",".join(members)])

    final_passwd_rows = system_passwd + new_user_passwd_rows
    final_group_rows = system_groups + new_user_group_rows + new_team_group_rows

    _write_atomic(passwd_path, "\n".join(":".join(r) for r in final_passwd_rows) + "\n")
    _write_atomic(group_path, "\n".join(":".join(r) for r in final_group_rows) + "\n")

    _enforce_user_permissions(users_dir, user_ids)
    _enforce_team_permissions(teams_dir, team_gids)

    return {
        "users": user_ids,
        "teams": team_gids,
        "team_members": team_members_map,
    }


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(
        description="Reconcile /users and /teams into /etc/passwd, /etc/group, and filesystem permissions."
    )
    parser.add_argument(
        "--root",
        type=Path,
        default=None,
        help="Root directory containing users/ and teams/ (defaults to RO_GIT_ROOT or /).",
    )
    parser.add_argument(
        "--etc-dir",
        type=Path,
        default=None,
        help="Directory containing passwd and group (defaults to RO_GIT_ETC_DIR or <root>/etc).",
    )
    args = parser.parse_args(argv)
    sync_users_and_groups(root_dir=args.root, etc_dir=args.etc_dir)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
